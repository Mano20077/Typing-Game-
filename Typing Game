    /* ============================================================
       3. GAME ENGINE
       ============================================================ */
    class ChromaTypeGame {
      constructor() {
        this.canvas = document.getElementById('game-canvas');
        this.ctx = this.canvas.getContext('2d');
        this.state = 'TITLE';
        this.currentLevelIndex = 0;
        this.levelConfig = null;
        this.score = 0; this.wpm = 0; this.accuracy = 100;
        this.totalKeystrokes = 0; this.correctKeystrokes = 0;
        this.currentCombo = 0; this.maxCombo = 0; this.chainReactions = 0;
        this.wordsCleared = 0; this.startTime = 0;
        this.groove = 0; this.multiplier = 1.0; this.isFever = false; this.feverTimer = 0;
        this.words = []; this.activeTarget = null; this.particles = []; this.shockwaves = []; this.floatingTexts = [];
        this.spawnTimer = 0; this.boss = null; this.coreHealth = 100; this.coreRotation = 0;
        this.shakeIntensity = 0; this.showKeyboard = true;
        this.sound = new SoundEngine();

        this.dom = {
          score: document.getElementById('score-display'),
          level: document.getElementById('level-display'),
          levelName: document.getElementById('level-name'),
          wpm: document.getElementById('wpm-display'),
          acc: document.getElementById('acc-display'),
          combo: document.getElementById('combo-display'),
          grooveFill: document.getElementById('groove-bar-fill'),
          multiplierBadge: document.getElementById('multiplier-badge'),
          feverText: document.getElementById('fever-text'),
          targetHud: document.getElementById('target-focus-hud'),
          targetDisplay: document.getElementById('target-word-display'),
          bigBanner: document.getElementById('big-banner'),
          subBanner: document.getElementById('sub-banner'),
          hud: document.getElementById('hud'),
          kbGuide: document.getElementById('keyboard-guide'),
          kbMatrix: document.getElementById('kb-matrix'),
          screenTitle: document.getElementById('screen-title'),
          screenInstructions: document.getElementById('screen-instructions'),
          screenLevels: document.getElementById('screen-levels'),
          screenSummary: document.getElementById('screen-summary'),
          screenGameOver: document.getElementById('screen-gameover'),
          screenPause: document.getElementById('screen-pause')
        };
        this.init();
      }

      init() {
        this.resizeCanvas();
        window.addEventListener('resize', () => this.resizeCanvas());
        this.buildVirtualKeyboard();
        this.setupEvents();
        this.setupLevelSelectionUI();
        requestAnimationFrame((t) => this.loop(t));
      }

      resizeCanvas() {
        this.width = window.innerWidth; this.height = window.innerHeight;
        this.canvas.width = this.width; this.canvas.height = this.height;
        this.centerX = this.width / 2; this.centerY = this.height / 2;
      }

      buildVirtualKeyboard() {
        const layout = [
          ['q', 'w', 'e', 'r', 't', 'y', 'u', 'i', 'o', 'p'],
          ['a', 's', 'd', 'f', 'g', 'h', 'j', 'k', 'l', ';'],
          ['z', 'x', 'c', 'v', 'b', 'n', 'm', ',', '.']
        ];
        this.dom.kbMatrix.innerHTML = '';
        layout.forEach(rowKeys => {
          const rowDiv = document.createElement('div');
          rowDiv.className = 'kb-row';
          rowKeys.forEach(k => {
            const keyDiv = document.createElement('div');
            const zone = KEYBOARD_ZONES[k] || 'index';
            keyDiv.className = `kb-key zone-${zone}`;
            keyDiv.dataset.key = k;
            keyDiv.textContent = k.toUpperCase();
            rowDiv.appendChild(keyDiv);
          });
          this.dom.kbMatrix.appendChild(rowDiv);
        });
        const spaceRow = document.createElement('div');
        spaceRow.className = 'kb-row';
        const spaceKey = document.createElement('div');
        spaceKey.className = 'kb-key space-key zone-thumb';
        spaceKey.dataset.key = ' ';
        spaceKey.textContent = 'SPACE';
        spaceRow.appendChild(spaceKey);
        this.dom.kbMatrix.appendChild(spaceRow);
      }

      setupEvents() {
        window.addEventListener('keydown', (e) => {
          this.sound.resume();
          if (e.key === 'Tab') { e.preventDefault(); this.toggleKeyboardGuide(); return; }
          if (e.key === 'Escape') {
            e.preventDefault();
            if (this.state === 'PLAYING') this.pauseGame();
            else if (this.state === 'PAUSED') this.resumeGame();
            return;
          }
          if (this.state === 'TITLE' && (e.key === ' ' || e.key === 'Enter')) { this.startLevel(0); return; }
          if (this.state === 'GAMEOVER' && e.key === 'Enter') { this.startLevel(this.currentLevelIndex); return; }
          if (this.state === 'SUMMARY' && e.key === 'Enter') { this.nextLevel(); return; }
          if (this.state === 'PLAYING') { this.handleKeystroke(e.key.toLowerCase()); }
        });

        document.getElementById('btn-start').onclick = () => { this.sound.init(); this.startLevel(0); };
        document.getElementById('btn-level-select').onclick = () => this.openModal('screenLevels');
        document.getElementById('btn-close-levels').onclick = () => this.closeModal('screenLevels');
        document.getElementById('btn-how-to-play').onclick = () => this.openModal('screenInstructions');
        document.getElementById('btn-close-instructions').onclick = () => this.closeModal('screenInstructions');
        document.getElementById('btn-sound-toggle').onclick = (e) => {
          const enabled = this.sound.toggleSound();
          e.target.textContent = enabled ? '🔊 SOUND: ON' : '🔇 SOUND: OFF';
        };
        document.getElementById('btn-next-level').onclick = () => this.nextLevel();
        document.getElementById('btn-retry-level').onclick = () => this.startLevel(this.currentLevelIndex);
        document.getElementById('btn-summary-menu').onclick = () => this.returnToMenu();
        document.getElementById('btn-restart-game').onclick = () => this.startLevel(this.currentLevelIndex);
        document.getElementById('btn-gameover-menu').onclick = () => this.returnToMenu();
        document.getElementById('btn-resume').onclick = () => this.resumeGame();
        document.getElementById('btn-quit-to-menu').onclick = () => this.returnToMenu();
        document.getElementById('toggle-kb-btn').onclick = () => this.toggleKeyboardGuide();

        document.querySelectorAll('.theme-dot').forEach(dot => {
          dot.onclick = () => {
            document.querySelectorAll('.theme-dot').forEach(d => d.classList.remove('active'));
            dot.classList.add('active');
            document.body.setAttribute('data-theme', dot.dataset.theme);
          };
        });
      }

      toggleKeyboardGuide() {
        this.showKeyboard = !this.showKeyboard;
        this.dom.kbGuide.classList.toggle('hidden', !this.showKeyboard);
      }

      setupLevelSelectionUI() {
        const grid = document.getElementById('level-selection-grid');
        grid.innerHTML = '';
        LEVEL_CONFIGS.forEach((lvl, idx) => {
          const card = document.createElement('div');
          card.className = 'level-card';
          card.innerHTML = `
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <span class="level-num-badge">ZONE ${lvl.id}</span>
              <span class="level-badge-tag">${lvl.bpm} BPM</span>
            </div>
            <strong style="color:#fff;">${lvl.name}</strong>
            <small style="color:#aaa;">${lvl.description}</small>
          `;
          card.onclick = () => { this.closeModal('screenLevels'); this.startLevel(idx); };
          grid.appendChild(card);
        });
      }

      openModal(k) { if (this.dom[k]) this.dom[k].classList.remove('hidden'); }
      closeModal(k) { if (this.dom[k]) this.dom[k].classList.add('hidden'); }

      startLevel(idx) {
        this.sound.init(); this.sound.resume();
        this.currentLevelIndex = idx;
        this.levelConfig = LEVEL_CONFIGS[this.currentLevelIndex] || LEVEL_CONFIGS[0];
        this.state = 'PLAYING';
        this.score = 0; this.wpm = 0; this.accuracy = 100;
        this.totalKeystrokes = 0; this.correctKeystrokes = 0;
        this.currentCombo = 0; this.maxCombo = 0; this.chainReactions = 0;
        this.wordsCleared = 0; this.startTime = Date.now();
        this.groove = 0; this.multiplier = 1.0; this.isFever = false;
        this.coreHealth = 100; this.words = []; this.activeTarget = null;
        this.particles = []; this.shockwaves = []; this.floatingTexts = [];
        this.boss = this.levelConfig.hasBoss ? { health: 100, maxHealth: 100 } : null;

        this.hideAllOverlays();
        this.dom.hud.classList.remove('hidden');
        if (this.showKeyboard) this.dom.kbGuide.classList.remove('hidden');
        this.updateHUD();
        this.sound.startMusic(this.levelConfig.bpm);
        this.triggerAnnouncement(`ZONE ${this.levelConfig.id}: ${this.levelConfig.name}`, this.levelConfig.subtitle);
      }

      nextLevel() { this.startLevel((this.currentLevelIndex + 1) % LEVEL_CONFIGS.length); }
      pauseGame() { this.state = 'PAUSED'; this.sound.stopMusic(); this.dom.screenPause.classList.remove('hidden'); }
      resumeGame() { this.state = 'PLAYING'; this.dom.screenPause.classList.add('hidden'); this.sound.startMusic(this.levelConfig.bpm); }
      returnToMenu() {
        this.state = 'TITLE'; this.sound.stopMusic(); this.hideAllOverlays();
        this.dom.screenTitle.classList.remove('hidden');
        this.dom.hud.classList.add('hidden');
        this.dom.kbGuide.classList.add('hidden');
        this.dom.targetHud.classList.add('hidden');
      }
      hideAllOverlays() {
        ['screenTitle', 'screenInstructions', 'screenLevels', 'screenSummary', 'screenGameOver', 'screenPause']
          .forEach(k => this.dom[k].classList.add('hidden'));
      }

      handleKeystroke(key) {
        this.totalKeystrokes++;
        const keyEl = this.dom.kbMatrix.querySelector(`[data-key="${key}"]`);
        if (keyEl) {
          keyEl.classList.add('pressed');
          setTimeout(() => keyEl.classList.remove('pressed'), 120);
        }

        if (this.activeTarget) {
          const targetChar = this.activeTarget.remainingChars[0];
          const match = (targetChar === '?' && /^[a-z0-9,.; ]$/.test(key)) || (targetChar === key);
          if (match) this.correctKeystroke(key);
          else this.incorrectKeystroke();
          return;
        }

        let bestCandidate = null;
        let closestDist = Infinity;
        for (const w of this.words) {
          const firstChar = w.remainingChars[0];
          const match = (firstChar === '?' && /^[a-z0-9,.; ]$/.test(key)) || (firstChar === key);
          if (match && w.distFromCenter < closestDist) {
            closestDist = w.distFromCenter; bestCandidate = w;
          }
        }

        if (bestCandidate) {
          this.activeTarget = bestCandidate;
          this.activeTarget.isLocked = true;
          this.correctKeystroke(key);
        } else {
          this.incorrectKeystroke();
        }
      }

      correctKeystroke(key) {
        this.correctKeystrokes++; this.currentCombo++;
        if (this.currentCombo > this.maxCombo) this.maxCombo = this.currentCombo;
        this.sound.playKeyClick(true);

        const typedChar = this.activeTarget.remainingChars.shift();
        this.activeTarget.typedChars.push(typedChar === '?' ? key.toUpperCase() : typedChar);
        this.spawnSparks(this.activeTarget.x, this.activeTarget.y, this.activeTarget.colorHex, 4);
        this.addGroove(5);

        if (this.activeTarget.remainingChars.length === 0) {
          this.completeWord(this.activeTarget);
          this.activeTarget = null;
        }
        this.updateTargetHUD();
        this.updateHUD();
        this.updateKeyboardTargetHighlight();
      }

      incorrectKeystroke() {
        this.sound.playTypo();
        this.currentCombo = 0;
        this.groove = Math.max(0, this.groove - 12);
        this.shake(4);
        this.updateHUD();
      }

      completeWord(word) {
        this.wordsCleared++;
        const basePts = word.text.length * 100;
        const earnedPoints = Math.round(basePts * this.multiplier * (this.isFever ? 3 : 1));
        this.score += earnedPoints;
        this.sound.playWordSuccess();

        this.createShockwave(word.x, word.y, word.colorHex, 130);
        this.spawnFloatingText(`+${earnedPoints}`, word.x, word.y, word.colorHex);

        let chainCount = 0;
        for (let i = this.words.length - 1; i >= 0; i--) {
          const other = this.words[i];
          if (other !== word && other.colorHex === word.colorHex) {
            const dx = other.x - word.x, dy = other.y - word.y;
            if (Math.sqrt(dx * dx + dy * dy) < 180) {
              chainCount++;
              const chainPts = 300 * chainCount;
              this.score += chainPts;
              this.createShockwave(other.x, other.y, other.colorHex, 90);
              this.spawnFloatingText(`CHAIN x${chainCount}! +${chainPts}`, other.x, other.y, '#ffe600');
              this.words.splice(i, 1);
            }
          }
        }
        if (chainCount > 0) {
          this.chainReactions += chainCount;
          this.sound.playChainReaction();
          this.shake(chainCount * 3);
        }

        const idx = this.words.indexOf(word);
        if (idx !== -1) this.words.splice(idx, 1);

        if (this.boss) {
          this.boss.health = Math.max(0, this.boss.health - 15 * (this.isFever ? 2.5 : 1));
          this.shake(8);
          if (this.boss.health <= 0) this.completeLevel();
        } else if (this.score >= this.levelConfig.targetScore) {
          this.completeLevel();
        }
      }

      completeLevel() {
        this.state = 'SUMMARY';
        this.sound.stopMusic();
        this.sound.playVictory();
        document.getElementById('sum-score').textContent = this.score.toLocaleString();
        document.getElementById('sum-wpm').textContent = Math.round(this.wpm);
        document.getElementById('sum-acc').textContent = `${this.accuracy}%`;
        document.getElementById('sum-combo').textContent = this.maxCombo;
        document.getElementById('sum-chains').textContent = this.chainReactions;
        document.getElementById('summary-tip').innerHTML = `💡 <strong>Coach Tip:</strong> ${this.levelConfig.tip}`;
        this.dom.screenSummary.classList.remove('hidden');
      }

      gameOver() {
        this.state = 'GAMEOVER';
        this.sound.stopMusic();
        document.getElementById('gov-words').textContent = this.wordsCleared;
        document.getElementById('gov-wpm').textContent = Math.round(this.wpm);
        document.getElementById('gov-score').textContent = this.score.toLocaleString();
        this.dom.screenGameOver.classList.remove('hidden');
      }

      addGroove(amount) {
        this.groove = Math.min(100, this.groove + amount);
        if (this.groove >= 100 && !this.isFever) {
          this.isFever = true; this.feverTimer = 10;
          this.sound.playFeverTrigger(); this.sound.setOverdrive(true);
          this.triggerAnnouncement('★ FEVER OVERDRIVE ★', '3X SCORE & BULLET TIME!');
          this.dom.feverText.classList.remove('hidden');
          this.shake(12);
        }
        this.multiplier = this.currentCombo >= 40 ? 4.0 : this.currentCombo >= 25 ? 3.0 : this.currentCombo >= 10 ? 2.0 : 1.0;
      }

      triggerAnnouncement(main, sub) {
        this.dom.bigBanner.textContent = main;
        this.dom.subBanner.textContent = sub || '';
        this.dom.bigBanner.classList.remove('hidden');
        this.dom.subBanner.classList.remove('hidden');
        clearTimeout(this.bannerTimeout);
        this.bannerTimeout = setTimeout(() => {
          this.dom.bigBanner.classList.add('hidden');
          this.dom.subBanner.classList.add('hidden');
        }, 2200);
      }

      spawnWord() {
        if (this.words.length >= this.levelConfig.maxActiveWords) return;
        const pool = this.levelConfig.words;
        let text = pool[Math.floor(Math.random() * pool.length)];
        if (this.levelConfig.hasWildcards && Math.random() < 0.28 && text.length > 3) {
          const r = 1 + Math.floor(Math.random() * (text.length - 2));
          text = text.substring(0, r) + '?' + text.substring(r + 1);
        }
        const sector = SECTOR_COLORS[Math.floor(Math.random() * SECTOR_COLORS.length)];
        const angle = Math.random() * Math.PI * 2;
        const dist = Math.max(this.width, this.height) * 0.48;

        this.words.push({
          text, typedChars: [], remainingChars: text.split(''),
          colorHex: sector.hex, angle, spiralAngle: angle, distFromCenter: dist,
          speed: this.levelConfig.baseSpeed * (0.85 + Math.random() * 0.3),
          isLocked: false, x: this.centerX + Math.cos(angle) * dist, y: this.centerY + Math.sin(angle) * dist
        });
      }

      loop() {
        if (this.state === 'PLAYING') {
          this.spawnTimer += 16;
          if (this.spawnTimer >= this.levelConfig.spawnInterval) { this.spawnWord(); this.spawnTimer = 0; }
          if (this.isFever) {
            this.feverTimer -= 0.016; this.groove = (this.feverTimer / 10) * 100;
            if (this.feverTimer <= 0) {
              this.isFever = false; this.groove = 0; this.sound.setOverdrive(false);
              this.dom.feverText.classList.add('hidden');
            }
          }
          const mod = this.isFever ? 0.45 : 1.0;
          for (let i = this.words.length - 1; i >= 0; i--) {
            const w = this.words[i];
            w.distFromCenter -= w.speed * 60 * 0.016 * mod;
            w.spiralAngle += 0.005 * mod;
            w.x = this.centerX + Math.cos(w.spiralAngle) * w.distFromCenter;
            w.y = this.centerY + Math.sin(w.spiralAngle) * w.distFromCenter;

            if (w.distFromCenter <= 65) {
              this.coreHealth -= 18; this.sound.playCoreHit(); this.shake(10);
              if (this.activeTarget === w) this.activeTarget = null;
              this.words.splice(i, 1);
              if (this.coreHealth <= 0) { this.gameOver(); return; }
            }
          }

          // Particles
          for (let i = this.shockwaves.length - 1; i >= 0; i--) {
            const s = this.shockwaves[i]; s.radius += 4; s.alpha -= 0.03;
            if (s.alpha <= 0) this.shockwaves.splice(i, 1);
          }
          for (let i = this.particles.length - 1; i >= 0; i--) {
            const p = this.particles[i]; p.x += p.vx; p.y += p.vy; p.alpha -= p.decay;
            if (p.alpha <= 0) this.particles.splice(i, 1);
          }
          for (let i = this.floatingTexts.length - 1; i >= 0; i--) {
            const f = this.floatingTexts[i]; f.y -= f.vy; f.alpha -= 0.02;
            if (f.alpha <= 0) this.floatingTexts.splice(i, 1);
          }

          const mins = (Date.now() - this.startTime) / 60000;
          if (mins > 0.05) this.wpm = (this.correctKeystrokes / 5) / mins;
          if (this.totalKeystrokes > 0) this.accuracy = Math.round((this.correctKeystrokes / this.totalKeystrokes) * 100);

          this.updateHUD(); this.updateTargetHUD(); this.updateKeyboardTargetHighlight();
          if (this.shakeIntensity > 0) this.shakeIntensity = Math.max(0, this.shakeIntensity - 0.4);
        }

        this.render();
        requestAnimationFrame(() => this.loop());
      }

      render() {
        this.ctx.save();
        if (this.shakeIntensity > 0) {
          this.ctx.translate((Math.random() - 0.5) * this.shakeIntensity, (Math.random() - 0.5) * this.shakeIntensity);
        }
        this.ctx.clearRect(0, 0, this.width, this.height);

        // Grid & Orbits
        this.ctx.strokeStyle = 'rgba(0, 243, 255, 0.05)';
        for (let r = 80; r < Math.max(this.width, this.height) * 0.6; r += 70) {
          this.ctx.beginPath(); this.ctx.arc(this.centerX, this.centerY, r, 0, Math.PI * 2); this.ctx.stroke();
        }

        // Target Laser
        if (this.activeTarget) {
          this.ctx.strokeStyle = this.activeTarget.colorHex; this.ctx.lineWidth = 2; this.ctx.setLineDash([8, 4]);
          this.ctx.beginPath(); this.ctx.moveTo(this.centerX, this.centerY); this.ctx.lineTo(this.activeTarget.x, this.activeTarget.y); this.ctx.stroke();
          this.ctx.setLineDash([]);
        }

        // Center Core
        this.coreRotation += 0.015;
        this.ctx.strokeStyle = this.isFever ? '#ff007f' : '#00f3ff';
        this.ctx.lineWidth = 3; this.ctx.beginPath();
        this.ctx.arc(this.centerX, this.centerY, 45, 0, Math.PI * 2); this.ctx.stroke();

        const hp = Math.max(0, this.coreHealth / 100);
        this.ctx.strokeStyle = hp > 0.4 ? '#39ff14' : '#ff0055';
        this.ctx.lineWidth = 6; this.ctx.beginPath();
        this.ctx.arc(this.centerX, this.centerY, 56, -Math.PI / 2, -Math.PI / 2 + Math.PI * 2 * hp); this.ctx.stroke();

        // Boss (Level 5)
        if (this.boss) {
          this.ctx.fillStyle = '#ff0055';
          this.ctx.font = '700 13px Chakra Petch';
          this.ctx.textAlign = 'center';
          this.ctx.fillText('SYNTAX TITAN', this.centerX, this.centerY - 220);
          this.ctx.strokeRect(this.centerX - 60, this.centerY - 215, 120, 8);
          this.ctx.fillRect(this.centerX - 59, this.centerY - 214, 118 * (this.boss.health / this.boss.maxHealth), 6);
        }

        // Word Orbs
        for (const w of this.words) {
          this.ctx.save();
          const padX = 14, textWidth = w.text.length * 15, boxW = textWidth + padX * 2, boxH = 36;
          const boxX = w.x - boxW / 2, boxY = w.y - boxH / 2;

          this.ctx.fillStyle = 'rgba(15, 12, 35, 0.85)';
          this.ctx.strokeStyle = w.colorHex;
          this.ctx.lineWidth = w.isLocked ? 3 : 1.5;
          this.ctx.beginPath();
          this.ctx.roundRect(boxX, boxY, boxW, boxH, 8);
          this.ctx.fill(); this.ctx.stroke();

          this.ctx.font = '700 18px Fira Code';
          this.ctx.textBaseline = 'middle';
          let startX = boxX + padX;

          this.ctx.fillStyle = '#39ff14';
          for (const ch of w.typedChars) { this.ctx.fillText(ch, startX, w.y); startX += 15; }

          w.remainingChars.forEach((ch, idx) => {
            this.ctx.fillStyle = (idx === 0 && w.isLocked) ? '#ffffff' : (ch === '?') ? '#ffe600' : '#d0d0f0';
            this.ctx.fillText(ch, startX, w.y);
            startX += 15;
          });
          this.ctx.restore();
        }

        // Particles & Shockwaves
        for (const s of this.shockwaves) {
          this.ctx.strokeStyle = s.color; this.ctx.lineWidth = 3; this.ctx.globalAlpha = s.alpha;
          this.ctx.beginPath(); this.ctx.arc(s.x, s.y, s.radius, 0, Math.PI * 2); this.ctx.stroke();
        }
        for (const p of this.particles) {
          this.ctx.fillStyle = p.color; this.ctx.globalAlpha = p.alpha;
          this.ctx.beginPath(); this.ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2); this.ctx.fill();
        }
        for (const f of this.floatingTexts) {
          this.ctx.fillStyle = f.color; this.ctx.globalAlpha = f.alpha;
          this.ctx.font = '800 16px Chakra Petch'; this.ctx.textAlign = 'center';
          this.ctx.fillText(f.text, f.x, f.y);
        }

        this.ctx.restore();
      }

      createShockwave(x, y, color, maxRadius) {
        this.shockwaves.push({ x, y, color, radius: 10, maxRadius, alpha: 1.0 });
      }
      spawnSparks(x, y, color, count = 6) {
        for (let i = 0; i < count; i++) {
          const a = Math.random() * Math.PI * 2, sp = 1 + Math.random() * 4;
          this.particles.push({ x, y, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp, size: 2 + Math.random() * 3, color, alpha: 1.0, decay: 0.04 });
        }
      }
      spawnFloatingText(text, x, y, color) {
        this.floatingTexts.push({ text, x, y, color, vy: 1.5, alpha: 1.0 });
      }
      shake(int) { this.shakeIntensity = Math.min(25, this.shakeIntensity + int); }

      updateHUD() {
        this.dom.score.textContent = this.score.toLocaleString();
        this.dom.level.textContent = this.levelConfig.id;
        this.dom.levelName.textContent = this.levelConfig.name;
        this.dom.wpm.textContent = Math.round(this.wpm);
        this.dom.acc.textContent = `${this.accuracy}%`;
        this.dom.combo.textContent = this.currentCombo;
        this.dom.multiplierBadge.textContent = `${this.multiplier.toFixed(1)}x`;
        this.dom.grooveFill.style.width = `${Math.min(100, this.groove)}%`;
      }

      updateTargetHUD() {
        if (!this.activeTarget) { this.dom.targetHud.classList.add('hidden'); return; }
        this.dom.targetHud.classList.remove('hidden');
        this.dom.targetDisplay.querySelector('.typed-part').textContent = this.activeTarget.typedChars.join('');
        this.dom.targetDisplay.querySelector('.current-char').textContent = this.activeTarget.remainingChars[0] || '';
        this.dom.targetDisplay.querySelector('.remaining-part').textContent = this.activeTarget.remainingChars.slice(1).join('');
      }

      updateKeyboardTargetHighlight() {
        this.dom.kbMatrix.querySelectorAll('.target-next, .target-candidate').forEach(el => el.classList.remove('target-next', 'target-candidate'));
        if (this.activeTarget && this.activeTarget.remainingChars.length > 0) {
          const ch = this.activeTarget.remainingChars[0].toLowerCase();
          if (ch !== '?') {
            const keyEl = this.dom.kbMatrix.querySelector(`[data-key="${ch}"]`);
            if (keyEl) keyEl.classList.add('target-next');
          }
        } else {
          for (const w of this.words) {
            if (w.remainingChars.length > 0 && w.remainingChars[0] !== '?') {
              const keyEl = this.dom.kbMatrix.querySelector(`[data-key="${w.remainingChars[0].toLowerCase()}"]`);
              if (keyEl) keyEl.classList.add('target-candidate');
            }
          }
        }
      }
    }

    window.addEventListener('load', () => { window.game = new ChromaTypeGame(); });
  </script>
</body>
</html>
