  <script>
    /* ============================================================
       1. PROCEDURAL WEB AUDIO SYNTHESIZER (NO EXTERNAL FILES)
       ============================================================ */
    class SoundEngine {
      constructor() {
        this.ctx = null;
        this.masterGain = null;
        this.sfxGain = null;
        this.musicGain = null;
        this.enabled = true;
        this.bpm = 115;
        this.step = 0;
        this.musicInterval = null;
        this.bassNotes = [65.41, 73.42, 82.41, 98.00];
        this.isOverdrive = false;
      }
      init() {
        if (this.ctx) return;
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        this.ctx = new AudioContext();
        this.masterGain = this.ctx.createGain();
        this.masterGain.gain.setValueAtTime(0.7, this.ctx.currentTime);
        this.masterGain.connect(this.ctx.destination);
        this.sfxGain = this.ctx.createGain();
        this.sfxGain.gain.setValueAtTime(0.8, this.ctx.currentTime);
        this.sfxGain.connect(this.masterGain);
        this.musicGain = this.ctx.createGain();
        this.musicGain.gain.setValueAtTime(0.35, this.ctx.currentTime);
        this.musicGain.connect(this.masterGain);
      }
      toggleSound() {
        this.enabled = !this.enabled;
        if (this.masterGain) this.masterGain.gain.setValueAtTime(this.enabled ? 0.7 : 0.0001, this.ctx.currentTime);
        return this.enabled;
      }
      resume() {
        if (this.ctx && this.ctx.state === 'suspended') this.ctx.resume();
      }
      playKeyClick(isTarget = false) {
        if (!this.enabled || !this.ctx) return;
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = isTarget ? 'triangle' : 'sine';
        const freq = isTarget ? 587.33 : 440;
        osc.frequency.setValueAtTime(freq, now);
        osc.frequency.exponentialRampToValueAtTime(freq * 0.5, now + 0.05);
        gain.gain.setValueAtTime(0.2, now);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.05);
        osc.connect(gain); gain.connect(this.sfxGain);
        osc.start(now); osc.stop(now + 0.06);
      }
      playTypo() {
        if (!this.enabled || !this.ctx) return;
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(140, now);
        osc.frequency.exponentialRampToValueAtTime(60, now + 0.12);
        gain.gain.setValueAtTime(0.25, now);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.12);
        osc.connect(gain); gain.connect(this.sfxGain);
        osc.start(now); osc.stop(now + 0.13);
      }
      playWordSuccess() {
        if (!this.enabled || !this.ctx) return;
        const now = this.ctx.currentTime;
        [392.00, 493.88, 587.33, 783.99].forEach((freq, idx) => {
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(freq, now + idx * 0.02);
          gain.gain.setValueAtTime(0.18, now + idx * 0.02);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.25);
          osc.connect(gain); gain.connect(this.sfxGain);
          osc.start(now + idx * 0.02); osc.stop(now + 0.28);
        });
      }
      playChainReaction() {
        if (!this.enabled || !this.ctx) return;
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(350, now);
        osc.frequency.exponentialRampToValueAtTime(1100, now + 0.18);
        gain.gain.setValueAtTime(0.3, now);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.25);
        osc.connect(gain); gain.connect(this.sfxGain);
        osc.start(now); osc.stop(now + 0.26);
      }
      playFeverTrigger() {
        if (!this.enabled || !this.ctx) return;
        const now = this.ctx.currentTime;
        const sweep = this.ctx.createOscillator();
        const sweepGain = this.ctx.createGain();
        sweep.type = 'sawtooth';
        sweep.frequency.setValueAtTime(150, now);
        sweep.frequency.exponentialRampToValueAtTime(1200, now + 0.4);
        sweepGain.gain.setValueAtTime(0.35, now);
        sweepGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.45);
        sweep.connect(sweepGain); sweepGain.connect(this.sfxGain);
        sweep.start(now); sweep.stop(now + 0.46);
      }
      playCoreHit() {
        if (!this.enabled || !this.ctx) return;
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'square';
        osc.frequency.setValueAtTime(120, now);
        osc.frequency.exponentialRampToValueAtTime(30, now + 0.3);
        gain.gain.setValueAtTime(0.4, now);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.32);
        osc.connect(gain); gain.connect(this.sfxGain);
        osc.start(now); osc.stop(now + 0.33);
      }
      playVictory() {
        if (!this.enabled || !this.ctx) return;
        const now = this.ctx.currentTime;
        [261.63, 329.63, 392.00, 523.25, 659.25, 783.99].forEach((freq, idx) => {
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(freq, now + idx * 0.08);
          gain.gain.setValueAtTime(0.25, now + idx * 0.08);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + idx * 0.08 + 0.35);
          osc.connect(gain); gain.connect(this.sfxGain);
          osc.start(now + idx * 0.08); osc.stop(now + idx * 0.08 + 0.38);
        });
      }
      startMusic(bpm = 115) {
        this.stopMusic();
        this.bpm = bpm;
        const stepDuration = (60 / this.bpm) / 4;
        this.musicInterval = setInterval(() => {
          if (!this.enabled || !this.ctx) return;
          this.playBeatStep(this.step % 16);
          this.step++;
        }, stepDuration * 1000);
      }
      stopMusic() {
        if (this.musicInterval) clearInterval(this.musicInterval);
        this.musicInterval = null;
        this.step = 0;
      }
      setOverdrive(active) {
        this.isOverdrive = active;
        if (this.musicInterval) this.startMusic(active ? this.bpm * 1.15 : this.bpm);
      }
      playBeatStep(step) {
        const now = this.ctx.currentTime;
        if (step === 0 || step === 4 || step === 8 || step === 12) {
          const kickOsc = this.ctx.createOscillator();
          const kickGain = this.ctx.createGain();
          kickOsc.type = 'sine';
          kickOsc.frequency.setValueAtTime(140, now);
          kickOsc.frequency.exponentialRampToValueAtTime(42, now + 0.1);
          kickGain.gain.setValueAtTime(0.65, now);
          kickGain.gain.exponentialRampToValueAtTime(0.001, now + 0.14);
          kickOsc.connect(kickGain); kickGain.connect(this.musicGain);
          kickOsc.start(now); kickOsc.stop(now + 0.15);
        }
        if (step === 4 || step === 12) {
          const snareOsc = this.ctx.createOscillator();
          const snareGain = this.ctx.createGain();
          snareOsc.type = 'triangle';
          snareOsc.frequency.setValueAtTime(180, now);
          snareOsc.frequency.exponentialRampToValueAtTime(70, now + 0.08);
          snareGain.gain.setValueAtTime(0.35, now);
          snareGain.gain.exponentialRampToValueAtTime(0.001, now + 0.1);
          snareOsc.connect(snareGain); snareGain.connect(this.musicGain);
          snareOsc.start(now); snareOsc.stop(now + 0.11);
        }
        if (step === 0 || step === 3 || step === 6 || step === 10 || step === 13) {
          const bassNote = this.bassNotes[Math.floor(step / 4) % this.bassNotes.length];
          const bassOsc = this.ctx.createOscillator();
          const bassGain = this.ctx.createGain();
          bassOsc.type = this.isOverdrive ? 'sawtooth' : 'triangle';
          bassOsc.frequency.setValueAtTime(bassNote, now);
          bassGain.gain.setValueAtTime(0.35, now);
          bassGain.gain.exponentialRampToValueAtTime(0.001, now + 0.16);
          bassOsc.connect(bassGain); bassGain.connect(this.musicGain);
          bassOsc.start(now); bassOsc.stop(now + 0.18);
        }
      }
    }

    /* ============================================================
